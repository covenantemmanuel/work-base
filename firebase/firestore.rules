rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} { allow read, update: if request.auth != null && request.auth.uid == userId; allow create: if request.auth != null; }
    match /chats/{chatId} { allow read, write: if request.auth != null; }
    match /messages/{messageId} { allow read, write: if request.auth != null; }
    match /notifications/{id} { allow read, write: if request.auth != null; }
    match /subscriptions/{id} { allow read, write: if request.auth != null; }
    match /payments/{id} { allow read: if request.auth != null; allow write: if false; }
    match /activities/{id} { allow read, write: if request.auth != null; }
  }
}
